{
  "name": "@jack-henry/jh-elements",
  "description": "Forge Design System web components.",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Banno/jack-henry-design-system.git"
  },
  "customElements": "custom-elements.json",
  "web-types": "web-types.json",
  "contributors": [
    "Audrey Bissiere-Grote",
    "Brad McCormick",
    "Maya Buser De"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "components/**/!(*.stories).js",
    "components/**/*.d.ts",
    "utils",
    "custom-elements.json",
    "web-types.json",
    "jsconfig.json",
    "NOTICE"
  ],
  "scripts": {
    "generate": "hygen component new",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build",
    "analyze": "cem analyze --config scripts/custom-elements-manifest.config.js && pnpm run postanalyze",
    "postanalyze": "node scripts/process-deprecated.js && node scripts/clean-web-types-numbers.js",
    "types": "node scripts/generate-declaration-files.js",
    "define": "pnpm run analyze && pnpm run types",
    "prepack": "cp ../../NOTICE .",
    "postpack": "rm -f NOTICE"
  },
  "dependencies": {
    "@jack-henry/jh-tokens": "workspace:2.0.0",
    "@jack-henry/jh-icons": "workspace:2.0.0",
    "lit": "3.3.1"
  },
  "devDependencies": {
    "@jack-henry/jh-datasets": "workspace:2.0.0",
    "@custom-elements-manifest/analyzer": "0.10.8",
    "@storybook/addon-a11y": "10.4.0",
    "@storybook/web-components-vite": "10.4.0",
    "chromatic": "18.1.0",
    "custom-element-jet-brains-integration": "1.7.0",
    "hygen": "6.2.11",
    "storybook": "10.4.0",
    "storybook-addon-tag-badges": "3.1.0",
    "vite": "5.4.12",
    "@storybook/addon-docs": "10.4.0", 
    "storybook-dark-mode": "5.0.0"
  }
}
