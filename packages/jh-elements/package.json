{
  "name": "@jack-henry/jh-elements",
  "description": "Forge Design System web components.",
  "version": "2.6.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Banno/jack-henry-design-system.git"
  },
  "customElements": "custom-elements.json",
  "web-types": "web-types.json",
  "type": "module",
  "contributors": [
    "Audrey Bissiere-Grote",
    "Brad McCormick",
    "Maya Buser De"
  ],
  "license": "Apache-2.0",
  "files": [
    "components/**/!(*.stories).js",
    "components/**/*.d.ts",
    "controllers",
    "utils",
    "custom-elements.json",
    "web-types.json",
    "jsconfig.json",
    "NOTICE"
  ],
  "scripts": {
    "generate": "node scripts/component-generation/generate-component.js",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build",
    "analyze": "cem analyze --config scripts/custom-elements-manifest.config.js && node scripts/generate-web-types.js",
    "types": "find components -name '*.d.ts' -delete && tsc -p tsconfig.build.json && node scripts/generate-tag-maps.js",
    "define": "pnpm run analyze && pnpm run types",
    "test:select": "node --test test/select.test.js",
    "prepack": "cp ../../NOTICE .",
    "postpack": "rm -f NOTICE"
  },
  "dependencies": {
    "@jack-henry/jh-icons": "workspace:2.2.1",
    "@jack-henry/jh-tokens": "workspace:2.2.0",
    "lit": "3.3.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.10.8",
    "@jack-henry/jh-datasets": "workspace:2.0.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/web-components-vite": "10.6.2",
    "chromatic": "18.1.0",
    "custom-element-jet-brains-integration": "1.7.0",
    "storybook": "10.6.2",
    "storybook-addon-tag-badges": "3.1.0",
    "storybook-dark-mode": "5.0.0",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
